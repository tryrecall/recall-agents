{
  "name": "@recall/google-meet",
  "version": "2026.5.22",
  "description": "Recall Google Meet participant plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/tryrecall/recall-agents"
  },
  "type": "module",
  "dependencies": {
    "commander": "14.0.3",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@recall/plugin-sdk": "workspace:*",
    "recall-agents": "workspace:*"
  },
  "peerDependencies": {
    "recall-agents": ">=2026.5.22"
  },
  "peerDependenciesMeta": {
    "recall-agents": {
      "optional": true
    }
  },
  "recall-agents": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@recall/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.5.22"
    },
    "build": {
      "openclawVersion": "2026.5.22"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
