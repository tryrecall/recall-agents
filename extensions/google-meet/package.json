{
  "name": "@steelengine/google-meet",
  "version": "2026.7.2-beta.3",
  "description": "SteelEngine Google Meet participant plugin for joining calls through Chrome or Twilio transports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/steelengineai/recall-agents"
  },
  "type": "module",
  "dependencies": {
    "jszip": "3.10.1",
    "pretty-ms": "9.3.0",
    "typebox": "1.3.3"
  },
  "devDependencies": {
    "@steelengine/plugin-sdk": "workspace:*",
    "steelengine": "workspace:*"
  },
  "peerDependencies": {
    "steelengine": ">=2026.7.2-beta.3"
  },
  "peerDependenciesMeta": {
    "steelengine": {
      "optional": true
    }
  },
  "steelengine": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@steelengine/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.7.2-beta.3"
    },
    "build": {
      "steelengineVersion": "2026.7.2-beta.3"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
