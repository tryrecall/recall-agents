{
  "name": "@steelengine/diffs-language-pack",
  "version": "2026.7.2-beta.3",
  "description": "SteelEngine diffs viewer syntax highlighting language pack",
  "repository": {
    "type": "git",
    "url": "https://github.com/steelengineai/recall-agents"
  },
  "type": "module",
  "devDependencies": {
    "@steelengine/plugin-sdk": "workspace:*"
  },
  "steelengine": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@steelengine/diffs-language-pack",
      "clawhubSpec": "clawhub:@steelengine/diffs-language-pack",
      "localPath": "extensions/diffs-language-pack",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.27"
    },
    "compat": {
      "pluginApi": ">=2026.7.2-beta.3"
    },
    "assetScripts": {
      "build": "node ../../scripts/build-diffs-viewer-runtime.mjs full"
    },
    "build": {
      "steelengineVersion": "2026.7.2-beta.3",
      "staticAssets": [
        {
          "source": "./assets/viewer-runtime.js",
          "output": "assets/viewer-runtime.js"
        }
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
