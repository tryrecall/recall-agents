{
  "name": "@steelengine/brave-plugin",
  "version": "2026.7.2-beta.3",
  "description": "SteelEngine Brave Search provider plugin for web search.",
  "repository": {
    "type": "git",
    "url": "https://github.com/steelengineai/recall-agents"
  },
  "type": "module",
  "devDependencies": {
    "@steelengine/plugin-sdk": "workspace:*"
  },
  "steelengine": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@steelengine/brave-plugin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10",
      "allowInvalidConfigRecovery": true
    },
    "compat": {
      "pluginApi": ">=2026.7.2-beta.3"
    },
    "build": {
      "steelengineVersion": "2026.7.2-beta.3"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
