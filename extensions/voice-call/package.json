{
  "name": "@recall/voice-call",
  "version": "2026.5.22",
  "description": "Recall voice-call plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/tryrecall/recall-agents"
  },
  "type": "module",
  "dependencies": {
    "commander": "14.0.3",
    "typebox": "1.1.38",
    "ws": "8.20.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@recall/plugin-sdk": "workspace:*",
    "recall": "workspace:*"
  },
  "peerDependencies": {
    "recall": ">=2026.5.22"
  },
  "peerDependenciesMeta": {
    "recall": {
      "optional": true
    }
  },
  "recall": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@recall/voice-call",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.5.22"
    },
    "build": {
      "openclawVersion": "2026.5.22"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
