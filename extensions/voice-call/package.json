{
  "name": "@steelengine/voice-call",
  "version": "2026.7.2-beta.3",
  "description": "SteelEngine voice-call plugin for Twilio, Telnyx, and Plivo phone calls.",
  "repository": {
    "type": "git",
    "url": "https://github.com/steelengineai/recall-agents"
  },
  "type": "module",
  "dependencies": {
    "typebox": "1.3.3",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@steelengine/plugin-sdk": "workspace:*",
    "steelengine": "workspace:*"
  },
  "peerDependencies": {
    "steelengine": ">=2026.7.2-beta.3"
  },
  "peerDependenciesMeta": {
    "steelengine": {
      "optional": true
    }
  },
  "steelengine": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@steelengine/voice-call",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.7.2-beta.3"
    },
    "build": {
      "steelengineVersion": "2026.7.2-beta.3"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
