{
  "name": "@recall/mattermost",
  "version": "2026.5.22",
  "description": "Recall Mattermost channel plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/tryrecall/recall-agents"
  },
  "type": "module",
  "dependencies": {
    "ws": "8.20.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@recall/plugin-sdk": "workspace:*",
    "recall": "workspace:*"
  },
  "peerDependencies": {
    "recall": ">=2026.5.22"
  },
  "peerDependenciesMeta": {
    "recall": {
      "optional": true
    }
  },
  "recall": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "mattermost",
      "label": "Mattermost",
      "selectionLabel": "Mattermost (plugin)",
      "docsPath": "/channels/mattermost",
      "docsLabel": "mattermost",
      "blurb": "self-hosted Slack-style chat; install the plugin to enable.",
      "order": 65
    },
    "install": {
      "minHostVersion": ">=2026.4.10"
    }
  }
}
