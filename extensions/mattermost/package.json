{
  "name": "@steelengine/mattermost",
  "version": "2026.7.2-beta.3",
  "description": "SteelEngine Mattermost channel plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/steelengineai/recall-agents"
  },
  "type": "module",
  "dependencies": {
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@steelengine/plugin-sdk": "workspace:*",
    "steelengine": "workspace:*"
  },
  "peerDependencies": {
    "steelengine": ">=2026.7.2-beta.3"
  },
  "peerDependenciesMeta": {
    "steelengine": {
      "optional": true
    }
  },
  "steelengine": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "mattermost",
      "label": "Mattermost",
      "selectionLabel": "Mattermost (plugin)",
      "docsPath": "/channels/mattermost",
      "docsLabel": "mattermost",
      "blurb": "self-hosted Slack-style chat; install the plugin to enable.",
      "order": 65
    },
    "install": {
      "clawhubSpec": "clawhub:@steelengine/mattermost",
      "npmSpec": "@steelengine/mattermost",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.9",
      "allowInvalidConfigRecovery": true
    },
    "compat": {
      "pluginApi": ">=2026.7.2-beta.3"
    },
    "build": {
      "steelengineVersion": "2026.7.2-beta.3",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
