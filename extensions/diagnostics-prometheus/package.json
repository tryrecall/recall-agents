{
  "name": "@recall/diagnostics-prometheus",
  "version": "2026.5.22",
  "description": "Recall diagnostics Prometheus exporter",
  "repository": {
    "type": "git",
    "url": "https://github.com/tryrecall/recall-agents"
  },
  "type": "module",
  "devDependencies": {
    "@recall/plugin-sdk": "workspace:*"
  },
  "recall-agents": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@recall/diagnostics-prometheus",
      "npmSpec": "@recall/diagnostics-prometheus",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.25"
    },
    "compat": {
      "pluginApi": ">=2026.5.22"
    },
    "build": {
      "openclawVersion": "2026.5.22"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
