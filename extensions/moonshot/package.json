{
  "name": "@steelengine/moonshot-provider",
  "version": "2026.7.2-beta.3",
  "description": "SteelEngine Moonshot provider plugin",
  "type": "module",
  "devDependencies": {
    "@steelengine/plugin-sdk": "workspace:*"
  },
  "steelengine": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@steelengine/moonshot-provider",
      "npmSpec": "@steelengine/moonshot-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.9"
    },
    "compat": {
      "pluginApi": ">=2026.7.2-beta.3"
    },
    "build": {
      "steelengineVersion": "2026.7.2-beta.3",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/steelengineai/recall-agents"
  }
}
