{
  "name": "@steelengine/tokenjuice",
  "version": "2026.7.2-beta.3",
  "description": "SteelEngine tokenjuice exec output compaction plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/steelengineai/recall-agents"
  },
  "type": "module",
  "dependencies": {
    "tokenjuice": "0.8.1"
  },
  "peerDependencies": {
    "steelengine": ">=2026.7.2-beta.3"
  },
  "peerDependenciesMeta": {
    "steelengine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@steelengine/plugin-sdk": "workspace:*",
    "steelengine": "workspace:*"
  },
  "steelengine": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@steelengine/tokenjuice",
      "npmSpec": "@steelengine/tokenjuice",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.28"
    },
    "compat": {
      "pluginApi": ">=2026.7.2-beta.3"
    },
    "build": {
      "steelengineVersion": "2026.7.2-beta.3",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
