{
  "name": "@steelengine/amazon-bedrock-mantle-provider",
  "version": "2026.7.2-beta.3",
  "description": "SteelEngine Amazon Bedrock Mantle provider plugin for OpenAI-compatible model routing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/steelengineai/recall-agents"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "0.109.1",
    "@aws/bedrock-token-generator": "1.1.0"
  },
  "devDependencies": {
    "@steelengine/plugin-sdk": "workspace:*"
  },
  "steelengine": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@steelengine/amazon-bedrock-mantle-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.7.2-beta.3"
    },
    "build": {
      "steelengineVersion": "2026.7.2-beta.3",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
