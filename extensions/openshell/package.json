{
  "name": "@recall/openshell-sandbox",
  "version": "2026.5.22",
  "description": "Recall sandbox backend for the NVIDIA OpenShell CLI",
  "repository": {
    "type": "git",
    "url": "https://github.com/tryrecall/recall-agents"
  },
  "type": "module",
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@recall/plugin-sdk": "workspace:*"
  },
  "recall-agents": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@recall/openshell-sandbox",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.5.22"
    },
    "build": {
      "openclawVersion": "2026.5.22",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
