{
  "name": "@steelengine/llama-cpp-provider",
  "version": "2026.7.2-beta.3",
  "description": "SteelEngine llama.cpp text inference and embedding provider plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/steelengineai/recall-agents"
  },
  "type": "module",
  "optionalDependencies": {
    "node-llama-cpp": "3.19.0"
  },
  "devDependencies": {
    "@steelengine/plugin-sdk": "workspace:*"
  },
  "steelengine": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@steelengine/llama-cpp-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.2"
    },
    "compat": {
      "pluginApi": ">=2026.7.2-beta.3"
    },
    "build": {
      "steelengineVersion": "2026.7.2-beta.3"
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
