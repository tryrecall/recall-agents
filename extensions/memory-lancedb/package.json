{
  "name": "@recall/memory-lancedb",
  "version": "2026.5.22",
  "description": "Recall LanceDB-backed long-term memory plugin with auto-recall/capture",
  "repository": {
    "type": "git",
    "url": "https://github.com/tryrecall/recall-agents"
  },
  "type": "module",
  "dependencies": {
    "@lancedb/lancedb": "0.29.0",
    "apache-arrow": "18.1.0",
    "openai": "6.38.0",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@recall/plugin-sdk": "workspace:*"
  },
  "recall": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@recall/memory-lancedb",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.5.22"
    },
    "build": {
      "openclawVersion": "2026.5.22"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
