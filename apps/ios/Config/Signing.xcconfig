// Shared iOS signing defaults for local development + CI.
#include "../build/Version.xcconfig"

STEELENGINE_IOS_DEFAULT_TEAM = FWJYW4S8P8
STEELENGINE_IOS_SELECTED_TEAM = $(STEELENGINE_IOS_DEFAULT_TEAM)
STEELENGINE_DEVELOPMENT_TEAM = $(STEELENGINE_IOS_SELECTED_TEAM)
STEELENGINE_CODE_SIGN_STYLE = Automatic
STEELENGINE_CODE_SIGN_IDENTITY = Apple Development
STEELENGINE_CODE_SIGN_ENTITLEMENTS = Sources/SteelEngine.entitlements
STEELENGINE_APP_BUNDLE_ID = ai.steelenginefoundation.app
STEELENGINE_APP_GROUP_ID = group.ai.steelenginefoundation.app.shared
STEELENGINE_WATCH_APP_BUNDLE_ID = ai.steelenginefoundation.app.watchkitapp
STEELENGINE_ACTIVITY_WIDGET_BUNDLE_ID = ai.steelenginefoundation.app.activitywidget
STEELENGINE_ACTIVITY_WIDGET_PROFILE =
STEELENGINE_WATCH_APP_PROFILE =

// Local contributors can override this by running scripts/ios-configure-signing.sh.
// Keep include after defaults: xcconfig is evaluated top-to-bottom.
#include? "../.local-signing.xcconfig"
#include? "../LocalSigning.xcconfig"

// Debug products install alongside release products and keep their app-group data separate.
STEELENGINE_DEBUG_APP_BUNDLE_ID = $(STEELENGINE_APP_BUNDLE_ID).debug
STEELENGINE_DEBUG_ACTIVITY_WIDGET_BUNDLE_ID = $(STEELENGINE_DEBUG_APP_BUNDLE_ID).activitywidget
STEELENGINE_DEBUG_WATCH_APP_BUNDLE_ID = $(STEELENGINE_DEBUG_APP_BUNDLE_ID).watchkitapp
STEELENGINE_DEBUG_APP_GROUP_ID = $(STEELENGINE_APP_GROUP_ID).debug

CODE_SIGN_STYLE = $(STEELENGINE_CODE_SIGN_STYLE)
CODE_SIGN_IDENTITY = $(STEELENGINE_CODE_SIGN_IDENTITY)
DEVELOPMENT_TEAM = $(STEELENGINE_DEVELOPMENT_TEAM)

// Let Xcode manage provisioning for the selected local team unless a local override pins one.
PROVISIONING_PROFILE_SPECIFIER =
