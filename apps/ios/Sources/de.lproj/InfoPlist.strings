"CFBundleDisplayName" = "$(STEELENGINE_APP_DISPLAY_NAME)";
/* SteelEngine source: "SteelEngine uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "SteelEngine verwendet Ihre Kalender, um Ereignisse und Planungskontext anzuzeigen, wenn Sie den Kalenderzugriff aktivieren.";
/* SteelEngine source: "SteelEngine uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "SteelEngine verwendet Ihre Kalender, um Ereignisse und Planungskontext anzuzeigen, wenn Sie den Kalenderzugriff aktivieren.";
/* SteelEngine source: "SteelEngine uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "SteelEngine verwendet Ihre Kalender, um Ereignisse hinzuzufügen, wenn Sie den Kalenderzugriff aktivieren.";
/* SteelEngine source: "SteelEngine uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "SteelEngine verwendet die Kamera, wenn Sie einen QR-Code zur Gateway-Einrichtung scannen oder Ihre gekoppelte Gateway oder Ihren Assistenten bitten, ein Foto oder kurzes Video von diesem iPhone aufzunehmen, beispielsweise um eine Verbindung zu Ihrer Gateway herzustellen oder Ihrem Assistenten ein Dokument, einen Gerätebildschirm oder einen Arbeitsbereich zu zeigen.";
/* SteelEngine source: "SteelEngine uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "SteelEngine verwendet Ihre Kontakte, damit Sie Personen suchen und referenzieren können, während Sie den Assistenten verwenden.";
/* SteelEngine source: "SteelEngine discovers and connects to your SteelEngine gateway on the local network." */
"NSLocalNetworkUsageDescription" = "SteelEngine erkennt Ihre SteelEngine-Gateway im lokalen Netzwerk und stellt eine Verbindung zu ihr her.";
/* SteelEngine source: "SteelEngine can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "SteelEngine kann Ihren Standort im Hintergrund teilen, wenn Sie „Immer“ aktivieren.";
/* SteelEngine source: "SteelEngine uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "SteelEngine verwendet Ihren Standort, wenn Sie die Standortfreigabe erlauben.";
/* SteelEngine source: "SteelEngine uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "SteelEngine verwendet das Mikrofon für Echtzeit-Chat, Sprachaktivierung, Push-to-Talk und Sprachnotizen.";
/* SteelEngine source: "SteelEngine may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "SteelEngine kann Bewegungsdaten verwenden, um gerätebewusste Interaktionen und Automatisierungen zu unterstützen.";
/* SteelEngine source: "SteelEngine reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "SteelEngine liest Ihre Schritte, Ihren Schlaf, Ihren Ruhepuls und Ihre Trainings aus der Apple Health-App, um von Ihnen angeforderte Zusammenfassungen zu erstellen und sie über Ihr Gateway an Ihren konfigurierten KI-Anbieter zu senden.";
/* SteelEngine source: "SteelEngine does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "SteelEngine schreibt keine Daten in die Apple Health-App. Es verwendet schreibgeschützte Daten, um von Ihnen angeforderte Zusammenfassungen zu erstellen und sie über Ihr Gateway an Ihren konfigurierten KI-Anbieter zu senden.";
/* SteelEngine source: "SteelEngine lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "SteelEngine ermöglicht deinem Assistenten, von dir erlaubte Fotos zu lesen, und lässt dich Fotos zum Teilen auswählen.";
/* SteelEngine source: "SteelEngine uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "SteelEngine verwendet deine Erinnerungen, um Aufgaben aufzulisten, hinzuzufügen und abzuschließen, wenn du den Zugriff auf Erinnerungen aktivierst.";
/* SteelEngine source: "SteelEngine uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "SteelEngine verwendet die Spracherkennung auf dem Gerät für den Sprechmodus und die Sprachaktivierung.";
