"CFBundleDisplayName" = "$(STEELENGINE_APP_DISPLAY_NAME)";
/* SteelEngine source: "SteelEngine uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "SteelEngine menggunakan kalender Anda untuk menampilkan acara dan konteks penjadwalan saat Anda mengaktifkan akses kalender.";
/* SteelEngine source: "SteelEngine uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "SteelEngine menggunakan kalender Anda untuk menampilkan acara dan konteks penjadwalan saat Anda mengaktifkan akses kalender.";
/* SteelEngine source: "SteelEngine uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "SteelEngine menggunakan kalender Anda untuk menambahkan acara saat Anda mengaktifkan akses kalender.";
/* SteelEngine source: "SteelEngine uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "SteelEngine menggunakan kamera saat Anda memindai kode QR penyiapan Gateway atau meminta Gateway yang dipasangkan atau asisten Anda untuk mengambil foto atau video pendek dari iPhone ini, misalnya untuk terhubung ke Gateway Anda atau menunjukkan dokumen, layar perangkat, atau ruang kerja kepada asisten Anda.";
/* SteelEngine source: "SteelEngine uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "SteelEngine menggunakan kontak Anda agar Anda dapat mencari dan merujuk orang saat menggunakan asisten.";
/* SteelEngine source: "SteelEngine discovers and connects to your SteelEngine gateway on the local network." */
"NSLocalNetworkUsageDescription" = "SteelEngine menemukan dan terhubung ke gateway SteelEngine Anda di jaringan lokal.";
/* SteelEngine source: "SteelEngine can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "SteelEngine dapat membagikan lokasi Anda di latar belakang saat Anda mengaktifkan Selalu.";
/* SteelEngine source: "SteelEngine uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "SteelEngine menggunakan lokasi Anda saat Anda mengizinkan berbagi lokasi.";
/* SteelEngine source: "SteelEngine uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "SteelEngine menggunakan mikrofon untuk obrolan realtime, voice wake, push-to-talk, dan pesan suara.";
/* SteelEngine source: "SteelEngine may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "SteelEngine dapat menggunakan data gerak untuk mendukung interaksi dan automasi yang sadar perangkat.";
/* SteelEngine source: "SteelEngine reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "SteelEngine membaca data langkah, tidur, detak jantung saat istirahat, dan olahraga Anda dari aplikasi Apple Health untuk membuat ringkasan yang Anda minta dan mengirimkannya melalui Gateway Anda ke penyedia AI yang dikonfigurasi.";
/* SteelEngine source: "SteelEngine does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "SteelEngine tidak menulis data ke aplikasi Apple Health. SteelEngine menggunakan data hanya-baca untuk membuat ringkasan yang Anda minta dan mengirimkannya melalui Gateway Anda ke penyedia AI yang dikonfigurasi.";
/* SteelEngine source: "SteelEngine lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "SteelEngine memungkinkan asisten Anda membaca foto yang Anda izinkan dan memungkinkan Anda memilih foto untuk dibagikan.";
/* SteelEngine source: "SteelEngine uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "SteelEngine menggunakan pengingat Anda untuk mencantumkan, menambahkan, dan menyelesaikan tugas saat Anda mengaktifkan akses pengingat.";
/* SteelEngine source: "SteelEngine uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "SteelEngine menggunakan pengenalan ucapan di perangkat untuk mode bicara dan bangun dengan suara.";
