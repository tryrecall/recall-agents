"CFBundleDisplayName" = "$(STEELENGINE_APP_DISPLAY_NAME)";
/* SteelEngine source: "SteelEngine uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "SteelEngine używa Twoich kalendarzy do wyświetlania wydarzeń i kontekstu planowania, gdy włączysz dostęp do kalendarza.";
/* SteelEngine source: "SteelEngine uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "SteelEngine używa Twoich kalendarzy do wyświetlania wydarzeń i kontekstu planowania, gdy włączysz dostęp do kalendarza.";
/* SteelEngine source: "SteelEngine uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "SteelEngine używa Twoich kalendarzy do dodawania wydarzeń, gdy włączysz dostęp do kalendarza.";
/* SteelEngine source: "SteelEngine uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "SteelEngine używa aparatu, gdy skanujesz kod QR konfiguracji Gateway lub poprosisz sparowane Gateway albo asystenta o zrobienie zdjęcia lub nagranie krótkiego wideo z tego iPhone’a, na przykład aby połączyć się z Gateway lub pokazać asystentowi dokument, ekran urządzenia albo miejsce pracy.";
/* SteelEngine source: "SteelEngine uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "SteelEngine używa Twoich kontaktów, aby umożliwić wyszukiwanie osób i odwoływanie się do nich podczas korzystania z asystenta.";
/* SteelEngine source: "SteelEngine discovers and connects to your SteelEngine gateway on the local network." */
"NSLocalNetworkUsageDescription" = "SteelEngine wykrywa i łączy się z Twoim gateway SteelEngine w sieci lokalnej.";
/* SteelEngine source: "SteelEngine can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "SteelEngine może udostępniać Twoją lokalizację w tle, gdy włączysz Zawsze.";
/* SteelEngine source: "SteelEngine uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "SteelEngine używa Twojej lokalizacji, gdy zezwolisz na udostępnianie lokalizacji.";
/* SteelEngine source: "SteelEngine uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "SteelEngine używa mikrofonu do czatu w czasie rzeczywistym, aktywacji głosowej, funkcji naciśnij i mów oraz notatek głosowych.";
/* SteelEngine source: "SteelEngine may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "SteelEngine może używać danych o ruchu do obsługi interakcji i automatyzacji zależnych od urządzenia.";
/* SteelEngine source: "SteelEngine reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "SteelEngine odczytuje z aplikacji Apple Health dane dotyczące kroków, snu, tętna spoczynkowego i treningów, aby tworzyć żądane podsumowania i wysyłać je za pośrednictwem Gateway do skonfigurowanego dostawcy AI.";
/* SteelEngine source: "SteelEngine does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "SteelEngine nie zapisuje danych w aplikacji Apple Health. Korzysta z danych tylko do odczytu, aby tworzyć żądane podsumowania i wysyłać je za pośrednictwem Gateway do skonfigurowanego dostawcy AI.";
/* SteelEngine source: "SteelEngine lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "SteelEngine pozwala Twojemu asystentowi odczytywać zdjęcia, na które zezwolisz, oraz pozwala wybrać zdjęcia do udostępnienia.";
/* SteelEngine source: "SteelEngine uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "SteelEngine używa Twoich przypomnień do wyświetlania, dodawania i oznaczania zadań jako ukończone, gdy włączysz dostęp do przypomnień.";
/* SteelEngine source: "SteelEngine uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "SteelEngine używa rozpoznawania mowy na urządzeniu w trybie rozmowy i do wybudzania głosem.";
