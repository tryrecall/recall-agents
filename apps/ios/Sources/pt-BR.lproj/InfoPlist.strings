"CFBundleDisplayName" = "$(STEELENGINE_APP_DISPLAY_NAME)";
/* SteelEngine source: "SteelEngine uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "O SteelEngine usa seus calendários para mostrar eventos e contexto de agendamento quando você ativa o acesso ao calendário.";
/* SteelEngine source: "SteelEngine uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "O SteelEngine usa seus calendários para mostrar eventos e contexto de agendamento quando você ativa o acesso ao calendário.";
/* SteelEngine source: "SteelEngine uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "O SteelEngine usa seus calendários para adicionar eventos quando você ativa o acesso ao calendário.";
/* SteelEngine source: "SteelEngine uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "O SteelEngine usa a câmera quando você escaneia um código QR de configuração do Gateway ou pede ao Gateway pareado ou ao assistente para capturar uma foto ou um vídeo curto deste iPhone, por exemplo, para se conectar ao Gateway ou mostrar ao assistente um documento, a tela de um dispositivo ou seu espaço de trabalho.";
/* SteelEngine source: "SteelEngine uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "O SteelEngine usa seus contatos para que você possa pesquisar e mencionar pessoas ao usar o assistente.";
/* SteelEngine source: "SteelEngine discovers and connects to your SteelEngine gateway on the local network." */
"NSLocalNetworkUsageDescription" = "O SteelEngine descobre e se conecta ao Gateway do SteelEngine na rede local.";
/* SteelEngine source: "SteelEngine can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "O SteelEngine pode compartilhar sua localização em segundo plano quando você ativa Sempre.";
/* SteelEngine source: "SteelEngine uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "O SteelEngine usa sua localização quando você permite o compartilhamento de localização.";
/* SteelEngine source: "SteelEngine uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "O SteelEngine usa o microfone para chat em tempo real, ativação por voz, pressionar para falar e notas de voz.";
/* SteelEngine source: "SteelEngine may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "O SteelEngine pode usar dados de movimento para oferecer suporte a interações e automações sensíveis ao dispositivo.";
/* SteelEngine source: "SteelEngine reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "O SteelEngine lê seus passos, sono, frequência cardíaca em repouso e exercícios no app Saúde da Apple para criar os resumos que você solicitar e enviá-los por meio do seu Gateway para o provedor de IA configurado.";
/* SteelEngine source: "SteelEngine does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "O SteelEngine não grava dados no app Saúde da Apple. Ele usa dados somente leitura para criar os resumos que você solicitar e enviá-los por meio do seu Gateway para o provedor de IA configurado.";
/* SteelEngine source: "SteelEngine lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "O SteelEngine permite que seu assistente leia as fotos que você autorizar e permite que você escolha fotos para compartilhar.";
/* SteelEngine source: "SteelEngine uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "O SteelEngine usa seus lembretes para listar, adicionar e concluir tarefas quando você ativa o acesso aos lembretes.";
/* SteelEngine source: "SteelEngine uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "O SteelEngine usa reconhecimento de fala no dispositivo para o modo de conversa e ativação por voz.";
