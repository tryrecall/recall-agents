"NSCalendarsFullAccessUsageDescription" = "SteelEngine ใช้ปฏิทินของคุณเพื่อแสดงกิจกรรมและบริบทการจัดกำหนดการเมื่อคุณเปิดใช้งานการเข้าถึงปฏิทิน";
/* SteelEngine source: "SteelEngine uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "SteelEngine ใช้ปฏิทินของคุณเพื่อแสดงกิจกรรมและบริบทการจัดกำหนดการเมื่อคุณเปิดใช้งานการเข้าถึงปฏิทิน";
/* SteelEngine source: "SteelEngine uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "SteelEngine ใช้ปฏิทินของคุณเพื่อเพิ่มกิจกรรมเมื่อคุณเปิดใช้งานการเข้าถึงปฏิทิน";
/* SteelEngine source: "SteelEngine uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "SteelEngine ใช้กล้องเมื่อคุณสแกนคิวอาร์โค้ดตั้งค่า Gateway หรือขอให้ Gateway หรือผู้ช่วยที่จับคู่ไว้ถ่ายภาพหรือวิดีโอสั้นจาก iPhone เครื่องนี้ เช่น เพื่อเชื่อมต่อกับ Gateway ของคุณ หรือแสดงเอกสาร หน้าจออุปกรณ์ หรือพื้นที่ทำงานให้ผู้ช่วยของคุณดู";
/* SteelEngine source: "SteelEngine uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "SteelEngine ใช้รายชื่อผู้ติดต่อของคุณเพื่อให้คุณค้นหาและอ้างอิงถึงบุคคลขณะใช้ผู้ช่วยได้";
/* SteelEngine source: "SteelEngine discovers and connects to your SteelEngine gateway on the local network." */
"NSLocalNetworkUsageDescription" = "SteelEngine ค้นพบและเชื่อมต่อกับ gateway SteelEngine ของคุณบนเครือข่ายภายใน";
/* SteelEngine source: "SteelEngine can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "SteelEngine สามารถแชร์ตำแหน่งที่ตั้งของคุณในเบื้องหลังเมื่อคุณเปิดใช้งาน \"เสมอ\"";
/* SteelEngine source: "SteelEngine uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "SteelEngine ใช้ตำแหน่งที่ตั้งของคุณเมื่อคุณอนุญาตให้แชร์ตำแหน่งที่ตั้ง";
/* SteelEngine source: "SteelEngine uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "SteelEngine ใช้ไมโครโฟนสำหรับแชทแบบเรียลไทม์ การปลุกด้วยเสียง push-to-talk และบันทึกเสียง";
/* SteelEngine source: "SteelEngine may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "SteelEngine อาจใช้ข้อมูลการเคลื่อนไหวเพื่อรองรับการโต้ตอบและระบบอัตโนมัติที่รับรู้ถึงอุปกรณ์";
/* SteelEngine source: "SteelEngine reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "SteelEngine อ่านจำนวนก้าว การนอนหลับ อัตราการเต้นของหัวใจขณะพัก และการออกกำลังกายของคุณจากแอปสุขภาพ Apple เพื่อสร้างสรุปที่คุณขอและส่งผ่าน Gateway ไปยังผู้ให้บริการ AI ที่คุณกำหนดค่าไว้";
/* SteelEngine source: "SteelEngine does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "SteelEngine ไม่เขียนข้อมูลลงในแอปสุขภาพ Apple โดยใช้ข้อมูลแบบอ่านอย่างเดียวเพื่อสร้างสรุปที่คุณขอและส่งผ่าน Gateway ไปยังผู้ให้บริการ AI ที่คุณกำหนดค่าไว้";
/* SteelEngine source: "SteelEngine lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "SteelEngine ช่วยให้ผู้ช่วยของคุณอ่านรูปภาพที่คุณอนุญาต และให้คุณเลือกรูปภาพที่จะแชร์ได้";
/* SteelEngine source: "SteelEngine uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "SteelEngine ใช้รายการเตือนความจำของคุณเพื่อแสดงรายการ เพิ่ม และทำงานให้เสร็จเมื่อคุณเปิดใช้งานสิทธิ์เข้าถึงรายการเตือนความจำ";
/* SteelEngine source: "SteelEngine uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "SteelEngine ใช้การรู้จำเสียงพูดบนอุปกรณ์สำหรับโหมดพูดคุยและการปลุกด้วยเสียง";
