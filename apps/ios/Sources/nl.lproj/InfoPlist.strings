/* SteelEngine source: "SteelEngine discovers and connects to your SteelEngine gateway on the local network." */
"NSLocalNetworkUsageDescription" = "SteelEngine vindt en maakt verbinding met je SteelEngine-gateway op het lokale netwerk.";
/* SteelEngine source: "SteelEngine can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "SteelEngine kan je locatie op de achtergrond delen wanneer je Altijd inschakelt.";
/* SteelEngine source: "SteelEngine uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "SteelEngine gebruikt je locatie wanneer je locatie delen toestaat.";
/* SteelEngine source: "SteelEngine uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "SteelEngine gebruikt de microfoon voor realtime chat, spraakwake, push-to-talk en spraaknotities.";
/* SteelEngine source: "SteelEngine may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "SteelEngine kan bewegingsgegevens gebruiken ter ondersteuning van apparaatafhankelijke interacties en automatiseringen.";
/* SteelEngine source: "SteelEngine reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "SteelEngine leest je stappen, slaap, rusthartslag en work-outs uit de Apple Gezondheid-app om door jou aangevraagde overzichten te maken en deze via je Gateway naar je geconfigureerde AI-provider te verzenden.";
/* SteelEngine source: "SteelEngine does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "SteelEngine schrijft geen gegevens naar de Apple Gezondheid-app. Het gebruikt alleen-lezengegevens om door jou aangevraagde overzichten te maken en deze via je Gateway naar je geconfigureerde AI-provider te verzenden.";
/* SteelEngine source: "SteelEngine lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "SteelEngine laat je assistent foto’s lezen die je toestaat en laat je foto’s kiezen om te delen.";
/* SteelEngine source: "SteelEngine uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "SteelEngine gebruikt je herinneringen om taken weer te geven, toe te voegen en te voltooien wanneer je toegang tot herinneringen inschakelt.";
/* SteelEngine source: "SteelEngine uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "SteelEngine gebruikt spraakherkenning op het apparaat voor de praatmodus en spraakactivering.";
